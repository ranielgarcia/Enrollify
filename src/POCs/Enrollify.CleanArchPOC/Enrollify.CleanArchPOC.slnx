<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".template.config/template.json" />
    <File Path="CleanArchitecture.nuspec" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/Enrollify.CleanArchPOC.Core/Enrollify.CleanArchPOC.Core.csproj" />
    <Project Path="src/Enrollify.CleanArchPOC.Infrastructure/Enrollify.CleanArchPOC.Infrastructure.csproj" />
    <Project Path="src/Enrollify.CleanArchPOC.UseCases/Enrollify.CleanArchPOC.UseCases.csproj" />
    <Project Path="src/Enrollify.CleanArchPOC.Web/Enrollify.CleanArchPOC.Web.csproj" />
  </Folder>
  <Folder Name="/src/_aspire/">
    <Project Path="src/Enrollify.CleanArchPOC.AspireHost/Enrollify.CleanArchPOC.AspireHost.csproj" />
    <Project Path="src/Enrollify.CleanArchPOC.ServiceDefaults/Enrollify.CleanArchPOC.ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/tests/">
