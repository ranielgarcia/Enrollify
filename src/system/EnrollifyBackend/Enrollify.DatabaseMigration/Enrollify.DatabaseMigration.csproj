<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Mocks\Common\Mock0001__Initial.sql" />
    <None Remove="SchemaScripts\DropProgrammabilityObjects.sql" />
    <None Remove="Scripts\Script0000 - Turn on Snapshop trans level.sql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
	  <EmbeddedResource Include="Mocks/**/*.sql" />
	  <EmbeddedResource Include="Scripts/**/*.sql" />
	  <EmbeddedResource Include="Seeds/**/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SchemaScripts\DropProgrammabilityObjects.sql" />
    <EmbeddedResource Include="SchemaScripts\Views\Views0001__LatestActiveCurriculumPerCourse.sql" />
  </ItemGroup>


	<ItemGroup>
		<PackageReference Include="dbup-sqlserver" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Spectre.Console.Cli" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="SchemaScripts\TVFs\" />
		<Folder Include="SchemaScripts\StoredProcedures\" />
		<Folder Include="SchemaScripts\Shared\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Enrollify.Core\Enrollify.Core.csproj" />
	</ItemGroup>


</Project>
